DirectorySlash On

ErrorDocument 403 "finished deleting all files"
ErrorDocument 404 "finished deleting all activities"

RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:|$)
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^(config|util|header|footer)(\.php)?$ - [F]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule . - [F]
RewriteRule !^($|[a-z_]+(\.php)?$|js/[a-z_-]+\.js$|style\.css$|icons/[a-z0-9_-]+\.png$|Mattarikon_logo_2\.png$|\.well-known/) - [F]

RewriteCond %{REQUEST_URI} ^(.*)/
RewriteRule ^ - [E=BASE:%1]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^.]+)$ %{ENV:BASE}/$1.php [L]
